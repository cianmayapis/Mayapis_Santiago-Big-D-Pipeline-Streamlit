# ---- Versions (change here only) ----
JAVA_VERSION=17
KAFKA_VERSION=4.4.0
KAFKA_SCALA=2.13
SPARK_VERSION=4.2.0
SPARK_PACKAGE=hadoop3          # Spark build flavour only; no HDFS is installed or required
MONGO_MAJOR=8.0
PY_VERSION=3.10.13
CONDA_ENV=bigdata

# ---- Spark connector packages (Scala 2.13 to match Spark) ----
SPARK_KAFKA_PACKAGE="org.apache.spark:spark-sql-kafka-0-10_2.13:${SPARK_VERSION}"
MONGO_SPARK_PACKAGE="org.mongodb.spark:mongo-spark-connector_2.13:11.1.0"
# Pass to spark-submit / pyspark as: --packages "$SPARK_PACKAGES"
SPARK_PACKAGES="${SPARK_KAFKA_PACKAGE},${MONGO_SPARK_PACKAGE}"

# ---- Kafka runtime ----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=streaming-data
KAFKA_PARTITIONS=1

# ---- MongoDB ----
MONGO_MODE="${MONGO_MODE:-atlas}"      # atlas | local
PROJECT_ENV_FILE="${PROJECT_ENV_FILE:-$(realpath -m "${SCRIPT_ROOT}/../.env")}"
MONGO_URI=mongodb://localhost:27017    # local mode only; in atlas mode the URI comes from .env
MONGO_DB=weather_db
MONGO_COLLECTION=readings

# ---- Locations ----
INSTALL_ROOT=/opt
DATA_ROOT="$HOME/pipeline-data"
KAFKA_DATA="$DATA_ROOT/kafka-logs"
SPARK_CHECKPOINT_DIR="$DATA_ROOT/spark-checkpoints"

# ---- Requirements ----
MIN_DISK_GB=15
MIN_RAM_GB=6
APACHE_MIRROR=https://downloads.apache.org
APACHE_ARCHIVE=https://archive.apache.org/dist

# ---- Python packages ----
# Path to the project's requirements.txt (the file you will submit)
REQUIREMENTS_FILE="${REQUIREMENTS_FILE:-$(realpath -m "${SCRIPT_ROOT}/../requirements.txt")}"

# Fallback, used only if REQUIREMENTS_FILE doesn't exist yet
BASE_PIP_PACKAGES=(
  "streamlit>=1.28.0" streamlit-autorefresh
  "pandas>=2.0.0" "numpy>=1.24.0" "plotly>=5.15.0"
  "kafka-python>=2.3" "python-dateutil>=2.8.2"
  "pymongo>=4.5.0" requests python-dotenv
  "pytest>=7.4.0" "black>=23.0.0" "flake8>=6.0.0"
)

# Pipeline tooling that is NOT part of the submitted requirements.txt
EXTRA_PIP_PACKAGES=( "pyspark==${SPARK_VERSION}" )