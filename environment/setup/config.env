# ---- Versions (change here only) ----
JAVA_VERSION=17
KAFKA_VERSION=4.4.0
KAFKA_SCALA=2.13
SPARK_VERSION=4.2.0
SPARK_PACKAGE=hadoop3
SPARK_KAFKA_PACKAGE="org.apache.spark:spark-sql-kafka-0-10_2.13:${SPARK_VERSION}"
MONGO_MAJOR=8.0
PY_VERSION=3.11
CONDA_ENV=weather-pipeline

# ---- Kafka runtime ----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=streaming-data
KAFKA_PARTITIONS=1

# ---- Locations ----
INSTALL_ROOT=/opt
DATA_ROOT="$HOME/pipeline-data"
KAFKA_DATA="$DATA_ROOT/kafka-logs"

# ---- Requirements ----
MIN_DISK_GB=15
MIN_RAM_GB=6
APACHE_MIRROR=https://downloads.apache.org
APACHE_ARCHIVE=https://archive.apache.org/dist

# ---- Python packages (pip, inside the conda env) ----
# Merged from the project's requirements.txt plus pyspark/pymongo.
PIP_PACKAGES=(
  "pyspark==${SPARK_VERSION}"
  "kafka-python>=2.3"
  "pymongo>=4.5.0"
  streamlit
  streamlit-autorefresh
  "pandas>=2.0.0"
  "numpy>=1.24.0"
  "plotly>=5.15.0"
  "python-dateutil>=2.8.2"
  requests
  python-dotenv
  "pytest>=7.4.0"
  "black>=23.0.0"
  "flake8>=6.0.0"
)